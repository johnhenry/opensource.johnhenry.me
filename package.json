{
  "name": "opensource-johnhenry-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentation hub for John Henry's open-source projects",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/sync-circuit-assets.mjs && npm run build:orrery",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-circuit-assets.mjs && npm run build:orrery",
    "build": "astro build",
    "check:links": "node scripts/check-links.mjs",
    "port:docs": "node scripts/port-docs.mjs",
    "preview": "astro preview",
    "start": "serve dist -l tcp://0.0.0.0:${PORT:-3000}",
    "check:external": "node scripts/check-external-links.mjs",
    "test": "node --test scripts/*.test.mjs",
    "build:orrery": "npm --prefix orrery ci --no-audit --no-fund && npm --prefix orrery run build:subpath",
    "orrery:node": "npm --prefix orrery run node",
    "sync:versions": "node scripts/sync-package-versions.mjs",
    "verify:cdn": "node scripts/verify-cdn-snippets.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.7",
    "@erisera-code/circuit": "^0.1.0",
    "@johnhenry/ecmanim": "^0.0.0",
    "astro": "^7.2.4",
    "serve": "^14.2.4",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "es-module-lexer": "^2.3.2"
  }
}
